# Vite proxies /api to Django in development. Use an absolute URL in production.
VITE_API_BASE_URL=/api/v1
# Keep false until the production SMS provider is configured and verified.
VITE_PASSWORD_RESET_ENABLED=false
# Show the one-click shared portfolio demo login.
VITE_DEMO_MODE_ENABLED=true
VITE_SENTRY_DSN=
VITE_APP_ENVIRONMENT=development
VITE_APP_RELEASE=local
